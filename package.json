{
  "name": "yemusic",
  "productName": "YEmusic",
  "version": "0.5.3",
  "private": true,
  "author": "YEmusic contributors",
  "description": "YEmusic - 融合洛雪音源生态与沉浸式界面的音乐播放器（Windows / Android），含 10 种歌词动画",
  "license": "Apache-2.0 AND AGPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && node scripts/build-electron.mjs",
    "build:fast": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "build:electron": "node scripts/build-electron.mjs",
    "dist:win": "node packaging/build-win.mjs",
    "android:sync": "vite build && cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@chenglou/pretext": "^0.0.9",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.3",
    "framer-motion": "^14.1.0",
    "i18next": "^26.5.2",
    "lucide-react": "^1.55.0",
    "music-metadata": "^12.1.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@electron/asar": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "pe-library": "^2.0.1",
    "resedit": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
